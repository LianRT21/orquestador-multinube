# ==============================================================================
# Resilience Orchestrator - Variables de Entorno de Ejemplo
# NO colocar credenciales reales en este archivo.
# ==============================================================================

# Entorno general
ENVIRONMENT=development
LOG_LEVEL=INFO

# PostgreSQL - Primario N1 (db-a)
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres_dev_pass
POSTGRES_DB=orders_db
DB_A_PORT=5432

# PostgreSQL - Réplica N2 (db-b)
DB_B_PORT=5433

# PostgreSQL - Replicación en Streaming Asíncrona
REPLICATION_USER=replicator
REPLICATION_PASSWORD=replicator_dev_pass
REPLICATION_SLOT=standby_slot
REPLICATION_DELAY_MS=200

# Toxiproxy (Plano de retardo de replicación)
TOXIPROXY_PORT=8474

# HAProxy (Reverse Proxy L7)
HAPROXY_HTTP_PORT=80
HAPROXY_STATS_PORT=8404
HAPROXY_RUNTIME_PORT=9999

# Aplicación de referencia
APP_INSTANCES_PER_CLOUD=1
APP_TIMEOUT_SECONDS=3.0
APP_A_PORT=8001
APP_B_PORT=8002

# Orquestador
ORCHESTRATOR_PORT=8080
PROBE_INTERVAL_S=1.0
PROBE_TIMEOUT_S=1.0
FAILURE_THRESHOLD=3
DEGRADED_LATENCY_MS=1500

# Monitoreo
PROMETHEUS_PORT=9090
BLACKBOX_PORT=9115
GRAFANA_PORT=3000
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=admin_dev_pass

# Experimentación
EXPERIMENT_SEED=42
STEADY_STATE_SECONDS=300
STABILIZATION_SECONDS=300
MAX_RECOVERY_WINDOW_SECONDS=900
CONSECUTIVE_SUCCESS_K=10
